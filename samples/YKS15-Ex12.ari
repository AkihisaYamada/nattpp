; @author Akihisa Yamada
; @author Keiichirou Kusakari
; @author Toshiki Sakabe
; Example 12 in "A Unified Ordering for Termination Proving". Sci. Comput. Program. 2015
; @doi 10.1016/j.scico.2014.07.009
(format TRS)
(fun f 2)
(fun g 1)
(rule (f x y) (g x))
(rule (f (g x) y) (f x (g x)))
(rule (f x (g y)) (f y y))
